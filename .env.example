# Copy to .env and fill values. NEVER commit .env with real credentials.
PARS_PORT=8080
SPRING_PROFILES_ACTIVE=dev
PARS_DB_URL=jdbc:postgresql://localhost:5432/nrb_pars?currentSchema=pars
PARS_DB_USER=postgres
PARS_DB_PASSWORD=change-me
PARS_JWT_SECRET=change-me-in-production-use-a-256-bit-secret-key
PARS_CORS_ORIGINS=http://localhost:5173

# AI (leave disabled until configured and governance-approved)
PARS_AI_ENABLED=false
PARS_AI_PROVIDER=openai          # or 'ollama' for free local models (no key needed)
PARS_AI_CHAT_MODEL=gpt-4o-mini   # for ollama: llama3.2:3b
PARS_AI_EMBEDDING_MODEL=text-embedding-3-small  # for ollama: nomic-embed-text
PARS_AI_EMBEDDING_DIMENSIONS=1536  # for ollama: 768 (V15 creates vector(768))
PARS_AI_API_KEY=
PARS_AI_BASE_URL=                # for ollama: http://localhost:11434
PARS_AI_MAX_TOKENS=1500
PARS_AI_TEMPERATURE=0.2
PARS_AI_TIMEOUT=30s
PARS_AI_MAX_CONCURRENT_REQUESTS=4
PARS_AI_EMBEDDING_DIMENSIONS=1536
PARS_AI_STORAGE_DIR=/var/data/nrb-pars-ai

# NRB external sources (crawler OFF by default)
NRB_FOREX_API_BASE_URL=https://www.nrb.org.np/api/forex/v1/
NRB_WEBSITE_BASE_URL=https://www.nrb.org.np/
NRB_CRAWLER_ENABLED=false
NRB_CRAWLER_USER_AGENT=PARS-NRB-KnowledgeBot/1.0
NRB_CRAWLER_DELAY_MS=2000
NRB_SYNC_CRON=0 0 6 * * *
NRB_FOREX_CACHE_TTL=10m
NRB_MAX_DOWNLOAD_SIZE=20971520
NRB_ALLOWED_DOMAINS=www.nrb.org.np,nrb.org.np
